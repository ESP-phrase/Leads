generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  email           String?
  role            String   @default("Agent")
  active          Boolean  @default(true)
  stripeSessionId String?
  paidAt          DateTime?
  leads           Lead[]
  referralCode    String?  @unique   // their personal invite code
  referredById    String?            // which worker recruited them
  referredBy      Worker?  @relation("Referrals", fields: [referredById], references: [id])
  referrals       Worker[] @relation("Referrals")
  createdAt       DateTime @default(now())
}

model Application {
  id                   String   @id @default(cuid())
  name                 String
  phone                String
  email                String?
  state                String?
  hoursPerWeek         Int?
  experience           String?
  whyJoin              String?
  referralSource       String?
  smsOptIn             Boolean  @default(false)
  smsOptInAt           DateTime?
  smsOptInIp           String?
  referralCode         String?            // referral code used when applying
  status               String   @default("pending")
  // pending → applied, no deposit yet
  // paid_pending      → paid $5, awaiting admin review
  // approved          → admin approved, worker created, paid covers activation
  // rejected_refunded → admin rejected, $5 refunded
  // rejected          → admin rejected, no payment to refund
  reviewNotes          String?
  paymentLink          String?
  stripeSessionId      String?
  stripePaymentIntent  String?
  reviewedAt           DateTime?
  paidAt               DateTime?
  workerId             String?
  createdAt            DateTime @default(now())
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String?
  address     String?
  city        String?
  state       String?
  category    String?
  rating      Float?
  reviewCount Int?
  placeId     String?    @unique
  hasWebsite  Boolean    @default(false)
  hasShopify  Boolean    @default(false)
  websiteUrl  String?
  slug        String?    @unique
  status      LeadStatus @default(FOUND)
  notes       String?
  previewUrl  String?
  workerId    String?
  worker      Worker?    @relation(fields: [workerId], references: [id])

  site        GeneratedSite?
  smsLogs     SmsLog[]
  sequence    SmsSequence?

  invoiceUrl  String?
  invoicePaid Boolean  @default(false)
  invoicedAt  DateTime?

  // Enrichment (Google Places + website scrape + GPT extraction)
  ownerName        String?
  ownerEmail       String?
  ownerPhone       String?
  ownerTitle       String?
  aboutSnippet     String?
  enrichmentConfidence String?   // 'high' | 'medium' | 'low' | 'none'
  enrichmentNotes  String?       // raw model output for debugging
  enrichedAt       DateTime?

  // Wealth proxy — 0-100 score computed from available signals
  wealthScore      Int?
  wealthSignals    String?       // human-readable list of signals (e.g. "high reviews, premium keywords, established")

  // Owner deep-enrichment (free: state SoS + DDG + GPT — manual trigger only)
  ownerLegalName       String?     // owner of record from state business filings
  ownerLegalAddress    String?     // address on filings
  ownerIncomeRange     String?     // GPT-estimated tier: '<$50k' | '$50-100k' | '$100-250k' | '$250-500k' | '$500k+'
  ownerLinkedinUrl     String?
  ownerOtherBusinesses String?     // other entities they're officer of
  ownerNewsSignals     String?     // GPT-summarized wealth signals from news mentions
  ownerDeepEnrichedAt  DateTime?
  ownerDeepEnrichSource String?    // 'opencorporates,ny-dos,tx-soc,ddg'

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model GeneratedSite {
  id           String   @id @default(cuid())
  leadId       String   @unique
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  headline     String
  subheadline  String
  services     String
  aboutText    String
  cityServed   String
  phone        String?
  address      String?
  primaryColor String   @default("#2563eb")
  template     String   @default("modern")
  vercelUrl    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SmsSequence {
  id          String    @id @default(cuid())
  leadId      String    @unique
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      String    @default("active")   // active | stopped | completed
  currentStep Int       @default(0)          // last step sent (0–3)
  startedAt   DateTime  @default(now())
  nextSendAt  DateTime                        // when to send the next step
  stoppedAt   DateTime?
  updatedAt   DateTime  @updatedAt
}

model SmsLog {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message    String
  status     String   @default("pending")
  messageSid String?
  sentAt     DateTime @default(now())
}

// Inbound preview requests from the B2B homepage form (or ads).
// Distinct from scraped Lead records — these are people who actively asked us
// to build them a website.
model PreviewRequest {
  id           String   @id @default(cuid())
  businessName String
  ownerName    String?
  email        String?
  phone        String?
  city         String?
  category     String?  // e.g. 'restaurant', 'plumber'
  websiteUrl   String?  // their current site, if any
  notes        String?  // free-text "anything else"
  smsOptIn     Boolean  @default(false)
  source       String?  // 'organic' | 'meta-ad' | 'google-ad' | 'referral' etc
  utmCampaign  String?
  utmSource    String?
  utmMedium    String?
  // Workflow
  status       String   @default("new")
  // new → in_review → preview_built → sold → declined → ghosted
  reviewNotes  String?
  reviewedAt   DateTime?
  // If we eventually build a site, link to the Lead row we create
  leadId       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PendingCall {
  id         String   @id @default(cuid())
  leadId     String
  leadPhone  String
  createdAt  DateTime @default(now())
}

enum LeadStatus {
  FOUND
  CALLED
  TEXTED
  INTERESTED
  CLOSED
  NOT_INTERESTED
}
